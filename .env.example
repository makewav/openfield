# OpenField configuration.
#
# Copy this file to `.env` for local development, or set the same names in
# Vercel (Project > Settings > Environment Variables). Set every one for the
# Preview environment as well as Production.
#
# The Kie key is server-side only. It must never reach the browser, a log line,
# or a committed file.

# ------------------------------------------------------------- provider ----

# Kie AI API key -> https://kie.ai (API keys page).
KIE_API_KEY=rpa_put_your_key_here

# -------------------------------------------------------------- storage ----
#
# Postgres: job history and the daily usage counter.
DATABASE_URL=postgres://user:password@host:5432/openfield

# Vercel Blob: every input and every result. Kie deletes generated files after
# 14 days and uploads after 24 hours, so results must be copied here on
# completion or the library empties itself.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_put_your_token_here

# ------------------------------------------------------------- the app ----

# Public origin of the deployment, used to build upload and callback URLs.
PUBLIC_BASE_URL=http://localhost:3000

# Hard daily ceiling on generation jobs. Stored in the database, not in memory.
DAILY_JOB_CAP=20

# Kill switch. Generation is refused unless this is exactly "true".
# Set it to false to stop all spending at once without touching anything else.
GENERATION_ENABLED=true

# ------------------------------------------------------------ optional ----

# Optional: an OpenAI-compatible server for the Director's scene planner.
# OPENFIELD_LLM_URL=http://127.0.0.1:8080/v1
# OPENFIELD_LLM_MODEL=
# OPENFIELD_LLM_KEY=
# OPENFIELD_LLM_REASONING=none
